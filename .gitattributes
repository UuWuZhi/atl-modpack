# 强制 LF 行尾,确保 packwiz refresh 在 Windows 上计算出的 hash
# 与 GitHub Pages 实际提供的文件字节一致。

*.pw.toml     text eol=lf
*.toml        text eol=lf
*.json        text eol=lf
*.json5       text eol=lf
*.jsonc       text eol=lf
*.py          text eol=lf
*.js          text eol=lf
*.zs          text eol=lf
*.snbt        text eol=lf
*.properties  text eol=lf
*.cfg         text eol=lf
*.ini         text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.md          text eol=lf
*.txt         text eol=lf

*.bat         text eol=crlf

*.jar         binary
*.zip         binary
*.png         binary
*.nbt         binary
*.db          binary
