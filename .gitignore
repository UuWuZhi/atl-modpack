# ============================================================
# All The Leisures — packwiz 仓库 .gitignore
# 原则:仓库只存元数据 (.pw.toml) 与原创内容,不存 mod jar 与运行时产物
# ============================================================

# ==== mod jar 本体(全部走 Modrinth/CurseForge CDN,不入库) ====
/mods/*.jar
/mods/**/*.jar
/mods/**/libs/

# ==== 导入包 / 构建产物 ====
/导入包/
/dist/
*.mrpack
*.jar
!/bootstrap/*.jar

# 资源包 zip:CDN 托管的走元数据,原创的(ResourcePacksJustForATL 等)需入库
# 故不全局忽略 *.zip,仅忽略构建产物
*.zip.orig
/构建产物/

# ==== 工具链 / 迁移中间产物 ====
/tools/__pycache__/
/tools/packwiz-cli/
_tmp*/
# 构建哈希缓存(入库,加速他人构建;若过期删后重新构建即可)
!/tools/cache/
!/tools/cache/seed.json

# ==== Minecraft 运行时生成(实例/客户端特有,不入库) ====
saves/
logs/
crash-reports/
reports/
screenshots/
*.log
*.jpg
*.jpeg
# 根级 cache(实例运行时目录,不入库);tools/cache 已在上方单独允许
/cache/
local/
downloads/
simplebackups/
backups/
dynamic-data-pack-cache/
dynamic-resource-pack-cache/
lightspeed-cache/
fancymenu_data/
.mixin.out/
.sable/
tlm_custom_pack/
schematics/
patchouli_books/
patchouli_data.json
ponders_watched.json
TrashSlotSaveState.json
usercache.json
usernamecache.json
servers.dat
*_cache/
*.tmp
*.bak

# ==== 例外:以下整合包原创内容必须入库(被上方规则误伤的) ====
# config 里的 xaero 配置(cfg/json/txt)
!config/xaero/
# config 里的 png 图标
!config/customwindowtitle/icon.png
# kubejs 纹理
!kubejs/assets/
!kubejs/assets/**
!kubejs/data/
!kubejs/data/**
# resourcepacks 的原创 assets
!resourcepacks/assets/
!resourcepacks/assets/**
# config 里的 oei 配置(json)
!config/oei/
# config 里的 fancymenu options.txt
!config/fancymenu/options.txt
# 以上 negate 需先恢复父目录遍历
!/config/
!/kubejs/
!/resourcepacks/

# ==== 服务器侧私有状态(不入库) ====
whitelist.json
ops.json
banned-players.json
banned-ips.json
*.pid
eula.txt

# ==== 系统/编辑器 ====
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
*.swp
